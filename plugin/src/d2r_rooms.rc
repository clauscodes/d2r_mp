#include <winres.h>
#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>
#include "version.h"

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    D2R_ROOMS_VERSION_MAJOR, D2R_ROOMS_VERSION_MINOR, D2R_ROOMS_VERSION_PATCH, 0
 PRODUCTVERSION D2R_ROOMS_VERSION_MAJOR, D2R_ROOMS_VERSION_MINOR, D2R_ROOMS_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "D2R Rooms"
			VALUE "FileDescription", "D2R Rooms: open TCP/IP rooms and the co-op relay (D2RLoader plugin)"
			VALUE "FileVersion", D2R_ROOMS_VERSION_STR
			VALUE "InternalName", "d2rl-d2r-rooms"
			VALUE "OriginalFilename", "d2rl-d2r-rooms.dll"
			VALUE "ProductName", "D2R Rooms"
			VALUE "ProductVersion", D2R_ROOMS_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
